#!/usr/bin/env bash
# Runs the deterministic merge/tag/publish sequence for /release-milestone
# Steps 6-14 — release-notes cleanup, main sync, PR merge, tag, GitHub
# release, milestone close. Everything here is mechanical (fixed command
# order, no judgment calls); /release-milestone keeps the human confirmation
# gate (its own Step 5) before calling this script.
#
# Usage: flow-release-milestone [--dry-run] [--reviewed-sha <sha>] [--checks-timeout <minutes>] <version> <pr-number> <milestone-number>
#
# <version>: e.g. v2.17.0
# <pr-number>: the milestone PR number (numeric, no leading '#')
# <milestone-number>: the GitHub milestone number to close
#
# --dry-run: print every command this script would run, in order, and exit
#   0 without running any of them (no git, gh, or filesystem mutation).
#   Read-only gh calls still run.
#
# --reviewed-sha <sha>: the PR head commit that the review and CI passed.
#   Before Step 6 changes anything, the PR head must be this commit. On a
#   rerun, it may also be this script's own release-notes removal commit on
#   top of it. Any other commit stops the script with exit 1: someone pushed
#   after the review. Step 8 always merges with --match-head-commit set to
#   the head that this script pushed, so a push during the run also fails
#   the merge instead of landing unreviewed code.
#
# --checks-timeout <minutes>: the time limit of the wait for required checks
#   (below). Default 30.
#
# Copy of the script: when this file is in the work tree of the repo that it
# releases (a `claude --plugin-dir plugins/flow` session), a checkout changes
# the file while bash reads it, and a session that starts on main runs the
# last release's script. So the script first extracts its own bin folder at
# the --reviewed-sha commit with git archive to a temp folder, and execs that
# copy. The helper scripts in that folder come from the same commit. A run
# from the work tree needs --reviewed-sha: without it, the script stops with
# exit 1. It does not run code that nobody reviewed. FLOW_RELEASE_REEXEC
# marks the copy, so it does not do this again. The temp folder is removed
# when the copy exits, or when the copy step stops with exit 1. With
# --dry-run there is no copy: a dry run checks out nothing, so the file
# cannot change while bash reads it. A script in the plugin cache does not
# change on a checkout, so it runs as it is. A copy of main from v1.2.0 or
# earlier has no copy step. Start that release on the milestone branch.
#
# Merge method: before Step 6, the script reads the classic branch
# protection and the rulesets of main. When either requires linear history,
# Step 8 merges with --squash (one commit on main for each release). Else it
# merges with --merge. A private repo on the GitHub Free plan has neither
# source, so it gets --merge. When the script cannot read one of the two
# sources for another reason, it stops with exit 1. The check runs only
# while the PR is open.
#
# Required checks: before Step 6, the script reads the required status check
# names of main from the classic branch protection and the rulesets. Step 6
# pushes a new PR head, so before Step 8 the script waits until each of those
# checks passes on that head. Until GitHub shows the pushed commit as the PR
# head, every check counts as pending. A required check with no run yet
# counts as pending. A skipped check counts as passed. A cancelled check
# counts as failed. When two runs have the same name, each must pass. It
# polls `gh pr checks` every FLOW_RELEASE_CHECK_INTERVAL seconds (default
# 30). The time limit counts the sleeps, not the time of the gh calls. A
# failed check, or no pass in --checks-timeout minutes, stops the run with
# exit 2 and nothing merges. With no required checks, there is no wait. The
# required check names come from main, not from `gh pr checks --required`:
# right after a push, that list can be empty.
#
# Resume: run the script again with the same arguments after it stops. Each
# step checks whether an earlier run already did its work, and skips it:
#   - Step 6 skips when the PR is merged. When the release-notes file is
#     already removed by a commit on the milestone branch, it pushes the
#     branch and continues.
#   - The wait for required checks and Step 8 skip when the PR is merged.
#     A rerun after a failed wait waits again.
#   - Step 8's gh pr merge --delete-branch normally deletes the local
#     milestone branch. When the branch is still there, Step 10 deletes it
#     with -D only when its tip is the PR head commit. Else it keeps the
#     branch and prints why. A failed delete prints a message and does not
#     stop the run.
#   - Step 11 skips when the tag exists on the PR's merge commit.
#   - Step 13 skips when the GitHub release exists.
#   - Steps 7, 9, 12 and 14 are safe to run again. Step 14 reads the
#     milestone state back and exits 2 if it is not closed.
# Step 6 saves the release notes to <plans>/releases/<version>-release-notes.md
# (a private folder, so it is not committed) before it removes them. Step 13
# creates the release from that copy. If the copy is missing, Step 13 finds
# the removal commit in the history of the PR head commit, and restores the
# file from the parent of that commit. This works after a squash merge too.
# When the head commit is not local, Step 13 first fetches
# refs/pull/<pr-number>/head.
#
# Reads from .claude/project.md:
#   release_notes  The release notes path. The text {version} in the value is
#                  replaced with <version>.
#   plans          The plan folder. Step 6 keeps the notes in <plans>/releases/.
#   release        Optional. `publish` (the default when the key is absent):
#                  Step 13 publishes the release and marks it Latest.
#                  `draft`: Step 13 creates a draft release.
#
# Exit codes:
#   0 = all steps completed (or --dry-run printed the plan)
#   1 = a check stopped the run before the failing step changed anything
#       (bad args, deploy remote, closed PR, release notes missing with no
#       removal commit, stray local commits on main, flow-repo failed, the
#       branch protection or rules of main cannot be read, a bad
#       --reviewed-sha, <pr-number>, --checks-timeout or
#       FLOW_RELEASE_CHECK_INTERVAL, a run from the work tree with no
#       --reviewed-sha, no copy of the script at the reviewed commit).
#       Fix the cause and run the script again.
#   2 = a step itself failed (e.g. merge conflict, push rejected, a pull
#       that is not a fast-forward, tag on the wrong commit, no project.md).
#       Fix the cause and run the script again. It skips the steps that
#       already completed. Also: no `release_notes` or no `plans` key in
#       .claude/project.md. This script cannot release without them, so it
#       stops before it changes anything. Also: a `release` value other than
#       publish or draft. The script stops before it changes anything.
#       Also: a required check failed, did not pass in --checks-timeout
#       minutes, or the PR head or its checks cannot be read.
#       Also: Step 13 finds no saved release notes and no removal commit.
#       Before Step 6 the same condition gives exit 1. In Step 13 the PR is
#       already merged, so exit 1 ("nothing changed") does not apply.

# -E: the ERR trap below must also fire for a failure inside run().
set -Eeuo pipefail

DRY_RUN=0
REVIEWED_SHA=""
CHECKS_TIMEOUT_MIN=30
ARGS=("$@")
while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --reviewed-sha)
      REVIEWED_SHA="${2:?--reviewed-sha needs a commit SHA}"
      shift 2
      ;;
    --checks-timeout)
      CHECKS_TIMEOUT_MIN="${2:?--checks-timeout needs a number of minutes}"
      shift 2
      ;;
    *) break ;;
  esac
done

USAGE="Usage: flow-release-milestone [--dry-run] [--reviewed-sha <sha>] [--checks-timeout <minutes>] <version> <pr-number> <milestone-number>"
VERSION="${1:?$USAGE}"
PR_NUMBER="${2:?$USAGE}"
MILESTONE_NUMBER="${3:?$USAGE}"

# The SHA goes to git archive before any other check, so it must be a full
# SHA: a branch name or a short SHA can name a commit that nobody reviewed.
if [ -n "$REVIEWED_SHA" ] && ! printf '%s' "$REVIEWED_SHA" | grep -qE '^[0-9a-f]{40}$'; then
  echo "flow-release-milestone: --reviewed-sha must be a full 40-character commit SHA (got '${REVIEWED_SHA}')." >&2
  exit 1
fi
case "$PR_NUMBER" in
  ''|*[!0-9]*)
    echo "flow-release-milestone: <pr-number> must be digits only (got '${PR_NUMBER}')." >&2
    exit 1
    ;;
esac

# positive_int <value> <what>
# Prints <value> as a decimal number. Exits 1 unless it is a positive
# integer. 10#: a leading zero must not make bash read the value as octal.
positive_int() {
  case "$1" in
    *[!0-9]*|'') ;;
    *) if [ "$((10#$1))" -gt 0 ]; then echo "$((10#$1))"; return 0; fi ;;
  esac
  echo "flow-release-milestone: $2 must be a positive whole number (got '$1')." >&2
  exit 1
}
CHECKS_TIMEOUT_MIN="$(positive_int "$CHECKS_TIMEOUT_MIN" "--checks-timeout (minutes)")"
CHECK_INTERVAL="$(positive_int "${FLOW_RELEASE_CHECK_INTERVAL:-30}" "FLOW_RELEASE_CHECK_INTERVAL (seconds)")"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- Run a copy of the script from the release commit ---
# See "Copy of the script" in the header. This runs before anything else, so
# each later line comes from the copy.
if [ -z "${FLOW_RELEASE_REEXEC:-}" ]; then
  TOP="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  # pwd -P: on macOS, /tmp and /var are symlinks, so compare real paths.
  [ -n "$TOP" ] && TOP="$(cd "$TOP" && pwd -P)"
  REAL_DIR="$(cd "$SCRIPT_DIR" && pwd -P)"
  # Outside a git work tree, TOP is empty. The pattern then cannot match.
  case "${TOP:-/nonexistent}:$REAL_DIR" in
    "${TOP}:${TOP}"/*)
      REL_DIR="${REAL_DIR#"$TOP"/}"
      SOURCE="$REVIEWED_SHA"
      if [ "$DRY_RUN" -eq 1 ]; then
        echo "[dry-run] a real run copies ${REL_DIR} from ${SOURCE:-<--reviewed-sha>} and runs that copy"
      elif [ -z "$SOURCE" ]; then
        echo "flow-release-milestone: this script runs from the work tree of the repo that it releases. Give --reviewed-sha <sha>, so it runs the reviewed copy. Stop. Nothing changed." >&2
        exit 1
      else
        if ! git cat-file -e "${SOURCE}^{commit}" 2>/dev/null; then
          git fetch -q origin "refs/pull/${PR_NUMBER}/head" || true
        fi
        # A template, so macOS mktemp uses TMPDIR as Linux mktemp does. cd
        # and pwd give the same form of the path that SCRIPT_DIR gets in the
        # copy (TMPDIR can end in a slash), so the trap guard below matches.
        COPY_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/flow-release.XXXXXX")"
        COPY_ROOT="$(cd "$COPY_ROOT" && pwd)"
        if ! git archive "$SOURCE" "$REL_DIR" 2>/dev/null | tar -x -C "$COPY_ROOT" \
          || [ ! -f "${COPY_ROOT}/${REL_DIR}/flow-release-milestone" ]; then
          rm -rf "$COPY_ROOT"
          echo "flow-release-milestone: commit '${SOURCE}' has no ${REL_DIR}/flow-release-milestone, or the commit is not in this repo. This script runs from the work tree, so it runs only the copy at the reviewed commit. Stop. Nothing changed." >&2
          exit 1
        fi
        echo "Running the release script from ${SOURCE} (copy in ${COPY_ROOT}/${REL_DIR})."
        export FLOW_RELEASE_REEXEC=1 FLOW_RELEASE_COPY_ROOT="$COPY_ROOT"
        exec bash "${COPY_ROOT}/${REL_DIR}/flow-release-milestone" "${ARGS[@]}"
      fi
      ;;
  esac
fi
# The copy removes its own temp folder at exit. exec replaced the first
# process, so no trap there can do it. The folder holds the helper scripts
# that SCRIPT_DIR names, so it must stay until the exit. The trap is set
# only when this script is in that folder, so a value left in the
# environment cannot remove another folder.
if [ -n "${FLOW_RELEASE_REEXEC:-}" ] && [ -n "${FLOW_RELEASE_COPY_ROOT:-}" ]; then
  case "$SCRIPT_DIR" in
    "${FLOW_RELEASE_COPY_ROOT%/}"/*) trap 'rm -rf "$FLOW_RELEASE_COPY_ROOT"' EXIT ;;
  esac
fi

# The repo is read one time. flow-repo prints its own error.
if ! REPO="$("${SCRIPT_DIR}/flow-repo")"; then
  exit 1
fi

# Read a required project fact. Exit 2 when the key is absent, empty, or
# project.md is missing. Nothing has changed at this point.
require_fact() {
  local key="$1" status=0
  FACT_VALUE="$("${SCRIPT_DIR}/flow-project-fact" "$key")" || status=$?
  if [ "$status" -eq 1 ]; then
    echo "flow-release-milestone: no '${key}' key in .claude/project.md. Add it. This script needs it to release." >&2
    exit 2
  elif [ "$status" -ne 0 ]; then
    exit 2
  elif [ -z "$FACT_VALUE" ]; then
    # An empty value gives a bad path: plans puts the notes copy at
    # /releases/, and release_notes names no notes file.
    echo "flow-release-milestone: the '${key}' key in .claude/project.md is empty. Give it a value. This script needs it to release." >&2
    exit 2
  fi
}

BRANCH="milestone/${VERSION}"
require_fact release_notes
NOTES_FILE=${FACT_VALUE//\{version\}/${VERSION}}
require_fact plans
KEEP_NOTES="${FACT_VALUE%/}/releases/${VERSION}-release-notes.md"

# The optional release key selects publish (the default) or draft. A bad
# value stops here, before anything changes.
RELEASE_STATUS=0
RELEASE_VALUE="$("${SCRIPT_DIR}/flow-project-fact" release)" || RELEASE_STATUS=$?
if [ "$RELEASE_STATUS" -eq 1 ]; then
  RELEASE_VALUE="publish"
  RELEASE_WHY="no release key"
elif [ "$RELEASE_STATUS" -ne 0 ]; then
  exit 2
else
  RELEASE_WHY="release: ${RELEASE_VALUE}"
fi
case "$RELEASE_VALUE" in
  publish) RELEASE_FLAG="--latest" ;;
  draft) RELEASE_FLAG="--draft" ;;
  *)
    echo "flow-release-milestone: release key is '${RELEASE_VALUE}'. Allowed values: publish, draft." >&2
    exit 2
    ;;
esac

run() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '[dry-run] %s\n' "$*"
  else
    "$@"
  fi
}

step() { echo "== $* =="; }

# require_sha <value> <what>
# Exits 2 unless <value> is a full commit SHA. <what> names it in the message.
require_sha() {
  if ! printf '%s' "$1" | grep -qE '^[0-9a-f]{40}$'; then
    echo "Could not read the ${2} (got: '${1}'). Stop and investigate." >&2
    exit 2
  fi
}

# notes_removal_commit <commit>
# Prints the commit in <commit>'s history that removed the release-notes
# file, or nothing. --full-history: when <commit> is a merge, the default
# history simplification can drop the side that removed the file.
notes_removal_commit() {
  git log -1 --full-history --format=%H --diff-filter=D "$1" -- "$NOTES_FILE"
}

PR_STATE="$(gh pr view "$PR_NUMBER" --json state --jq '.state')"
case "$PR_STATE" in
  OPEN|MERGED) ;;
  *)
    echo "PR #${PR_NUMBER} is ${PR_STATE}, not OPEN or MERGED. Stop." >&2
    exit 1
    ;;
esac

trap 'echo "flow-release-milestone: a command failed at line ${LINENO}. Fix the cause, then run the script again. It skips the steps that already completed." >&2; exit 2' ERR

# --- Check local main before Step 6 pushes anything ---
# Exit 1 promises that nothing changed, so this check runs before Step 6
# pushes the notes removal. On a diverged main, Step 7's pull would also
# fail with a less clear message.
step "Check local main"
run git fetch origin --prune
if [ "$DRY_RUN" -eq 0 ]; then
  AHEAD="$(git rev-list --count origin/main..main)"
  if [ "$AHEAD" != "0" ]; then
    echo "Local main has ${AHEAD} commit(s) not on origin/main. Stop — park them on a side branch first." >&2
    exit 1
  fi
else
  echo "[dry-run] git rev-list --count origin/main..main  # expect: 0"
fi

# Exits 1 unless <commit> is the reviewed commit, or this script's own notes
# removal directly on top of it (a rerun after Step 6). <where> names the
# check in the message.
require_reviewed() {
  local commit="$1" where="$2" parent change
  [ -z "$REVIEWED_SHA" ] && return 0
  [ "$commit" = "$REVIEWED_SHA" ] && return 0
  parent="$(git rev-parse --verify --quiet "${commit}^" || true)"
  change="$(git diff-tree --no-commit-id --name-status -r "$commit" 2>/dev/null || true)"
  if [ "$parent" = "$REVIEWED_SHA" ] && [ "$change" = "D	${NOTES_FILE}" ]; then
    return 0
  fi
  echo "${where}: ${commit} is not the reviewed commit ${REVIEWED_SHA}. A commit landed after the review. Stop. Review the new commit, then run the release again." >&2
  exit 1
}

# --- Check that the PR head is the reviewed commit ---
# Runs before Step 6, so exit 1 still means that nothing changed.
if [ -n "$REVIEWED_SHA" ] && [ "$PR_STATE" = "OPEN" ]; then
  step "Check the reviewed commit"
  require_reviewed "$(gh pr view "$PR_NUMBER" --json headRefOid --jq .headRefOid)" "PR #${PR_NUMBER} head"
fi

# --- Check the merge method and the required checks ---
# GitHub refuses a merge commit when main requires linear history, and
# refuses any merge until the required checks pass on the PR head. Classic
# branch protection or a ruleset can require each, so read both. One read of
# each source gives both answers: the first line is the linear-history value,
# and each later line is a required check name. These reads run before Step
# 6, so exit 1 still means that nothing changed.

# gh_capture <gh args...>
# Runs gh and sets GH_STATUS, GH_OUT (stdout) and GH_ERR (stderr). A gh
# warning on stderr then cannot change the value that the caller matches.
# The `|| exit $?` inside the substitution keeps the ERR trap quiet: bash
# 3.2 runs the inherited trap in the subshell even when `||` follows the
# substitution.
gh_capture() {
  local err
  err="$(mktemp)"
  GH_STATUS=0
  GH_OUT="$(gh "$@" 2>"$err" || exit $?)" || GH_STATUS=$?
  GH_ERR="$(cat "$err")"
  rm -f "$err"
}

# gh_read <api path> <jq filter>
# gh_capture for a gh api read. On failure GH_OUT also holds stderr, because
# gh puts the message there.
gh_read() {
  gh_capture api "$1" --jq "$2"
  if [ "$GH_STATUS" -ne 0 ]; then
    GH_OUT="${GH_OUT}${GH_ERR}"
  fi
}

# protection_fail <gh output>
# Exits 1 with the gh output. Nothing changed yet.
protection_fail() {
  echo "flow-release-milestone: cannot read the branch protection or rules of main. gh said: ${1}" >&2
  echo "The classic protection read needs admin read access to the repo. Get that access or fix the cause, then run the script again. Nothing changed." >&2
  exit 1
}

# A private repo on the GitHub Free plan has no branch protection and no
# rulesets. GitHub answers both reads with this text. Such a repo cannot
# require linear history or checks.
NO_PROTECTION_PLAN="Upgrade to GitHub Pro"

MERGE_FLAG="--merge"
REQUIRED_CHECKS=""
if [ "$PR_STATE" = "OPEN" ]; then
  step "Check the merge method and the required checks"
  gh_read "repos/${REPO}/branches/main/protection" \
    '(.required_linear_history.enabled // false), ((.required_status_checks.contexts // []) + [(.required_status_checks.checks // [])[].context] | .[])'
  if [ "$GH_STATUS" -eq 0 ]; then
    FIRST="$(printf '%s\n' "$GH_OUT" | sed -n 1p)"
    REQUIRED_CHECKS="$(printf '%s\n' "$GH_OUT" | sed 1d)"
  else
    # On failure, match the whole output: gh can print a notice first.
    FIRST="$GH_OUT"
  fi
  case "${GH_STATUS}:${FIRST}" in
    0:true) MERGE_FLAG="--squash" ;;
    0:false|*"Branch not protected"*|*"${NO_PROTECTION_PLAN}"*) ;;
    *) protection_fail "$GH_OUT" ;;
  esac
  gh_read "repos/${REPO}/rules/branches/main" \
    '([.[] | select(.type == "required_linear_history")] | length), (.[] | select(.type == "required_status_checks") | .parameters.required_status_checks[].context)'
  if [ "$GH_STATUS" -eq 0 ]; then
    FIRST="$(printf '%s\n' "$GH_OUT" | sed -n 1p)"
    REQUIRED_CHECKS="$(printf '%s\n%s\n' "$REQUIRED_CHECKS" "$(printf '%s\n' "$GH_OUT" | sed 1d)")"
  else
    FIRST="$GH_OUT"
  fi
  # A ruleset read that fails stops the run, also when classic protection
  # already chose squash: without it, the script does not know each
  # required check.
  case "${GH_STATUS}:${FIRST}" in
    0:0|*"${NO_PROTECTION_PLAN}"*) ;;
    # A count must be digits only. Anything else is not a valid answer.
    0:|0:*[!0-9]*) protection_fail "$GH_OUT" ;;
    0:*) MERGE_FLAG="--squash" ;;
    *) protection_fail "$GH_OUT" ;;
  esac
  if [ "$MERGE_FLAG" = "--squash" ]; then
    echo "Merge method: squash (main requires linear history)"
  else
    echo "Merge method: merge (main does not require linear history)"
  fi
  REQUIRED_CHECKS="$(printf '%s\n' "$REQUIRED_CHECKS" | sed '/^$/d' | sort -u)"
  if [ -n "$REQUIRED_CHECKS" ]; then
    echo "Required checks: $(printf '%s\n' "$REQUIRED_CHECKS" | paste -sd ',' - | sed 's/,/, /g')"
  else
    echo "Required checks: none"
  fi
fi

# --- Step 6: save release notes, delete the file, push to the milestone branch ---
step "Step 6: remove release notes from milestone branch"
if [ "$PR_STATE" = "MERGED" ]; then
  echo "PR #${PR_NUMBER} is already merged — skipping."
else
  run git checkout "$BRANCH"
  run git pull --ff-only origin "$BRANCH"
  # The pull can bring a commit that landed after the check above. Check
  # again on the local branch, before this script commits or pushes.
  if [ "$DRY_RUN" -eq 0 ]; then
    require_reviewed "$(git rev-parse HEAD)" "Local ${BRANCH} after the pull"
  fi
  if [ "$DRY_RUN" -eq 1 ] || [ -f "$NOTES_FILE" ]; then
    run mkdir -p "$(dirname "$KEEP_NOTES")"
    run cp "$NOTES_FILE" "$KEEP_NOTES"
    run git rm "$NOTES_FILE"
    run git commit -m "chore: remove v${VERSION#v} release notes — published to GitHub Releases"
    if [ "$DRY_RUN" -eq 0 ]; then
      require_reviewed "$(git rev-parse HEAD)" "Notes removal commit"
    fi
  else
    REMOVED_IN="$(notes_removal_commit HEAD)"
    if [ -z "$REMOVED_IN" ]; then
      echo "No ${NOTES_FILE} on ${BRANCH}, and no commit on the branch removed it. Stop." >&2
      exit 1
    fi
    echo "${NOTES_FILE} already removed in ${REMOVED_IN} — continuing."
  fi
  run git push origin "$BRANCH"

  if [ "$DRY_RUN" -eq 0 ]; then
    MERGEABLE="$(gh pr view "$PR_NUMBER" --json mergeable --jq '.mergeable')"
    if [ "$MERGEABLE" != "MERGEABLE" ]; then
      echo "PR #${PR_NUMBER} is not cleanly mergeable after Step 6's push (state: ${MERGEABLE}). Resolve it, then run the script again." >&2
      exit 2
    fi
  else
    echo "[dry-run] gh pr view $PR_NUMBER --json mergeable --jq '.mergeable'"
  fi
fi

# --- Step 7: switch to main and pull ---
step "Step 7: sync main"
run git checkout main
run git pull --ff-only origin main

# --- Wait for the required checks on the PR head ---
# EXPECTED_HEAD is the head that this script pushed. The local branch
# matches origin after Step 6. The wait reads the checks only when the PR
# shows this head. Step 8 merges only this head, so a push by anyone else
# since then fails the merge.
if [ "$PR_STATE" = "OPEN" ]; then
  if [ "$DRY_RUN" -eq 1 ]; then
    EXPECTED_HEAD="<milestone branch HEAD after Step 6>"
  else
    EXPECTED_HEAD="$(git rev-parse "refs/heads/${BRANCH}")"
  fi
fi

# gh_poll_fail <what>
# Exits 2 with the gh error. Step 6 already pushed, so exit 1 does not apply.
gh_poll_fail() {
  echo "flow-release-milestone: cannot read the $1 of PR #${PR_NUMBER}. gh said: ${GH_ERR:-nothing (exit ${GH_STATUS})}" >&2
  echo "Nothing merged. Fix the cause, then run the script again." >&2
  exit 2
}

# GitHub shows the pushed commit as the PR head some time after the push.
# Until then, `gh pr checks` shows the checks of the old head, so the head
# is read first. In the gh versions that we tried, `gh pr checks --json`
# exits 0 for each check state. Other versions can exit 8 while a check is
# pending. The script accepts 0 and 8, and reads the state of each check
# from its bucket. Before
# the first run starts, it answers "no checks reported" with exit 1: each
# required check is then pending. This text match depends on the gh wording.
step "Wait for required checks"
if [ "$PR_STATE" = "MERGED" ]; then
  echo "PR #${PR_NUMBER} is already merged — skipping."
elif [ -z "$REQUIRED_CHECKS" ]; then
  echo "No required checks on main — no wait."
elif [ "$DRY_RUN" -eq 1 ]; then
  echo "[dry-run] gh pr checks $PR_NUMBER --json name,bucket  # wait until each required check passes on the pushed head, at most ${CHECKS_TIMEOUT_MIN} min"
else
  LIMIT=$((CHECKS_TIMEOUT_MIN * 60))
  ELAPSED=0
  while :; do
    PENDING=""
    gh_capture pr view "$PR_NUMBER" --json headRefOid --jq .headRefOid
    [ "$GH_STATUS" -eq 0 ] || gh_poll_fail "head commit"
    if [ "$GH_OUT" != "$EXPECTED_HEAD" ]; then
      PENDING="the PR head ${EXPECTED_HEAD} (GitHub shows ${GH_OUT})"
    else
      gh_capture pr checks "$PR_NUMBER" --json name,bucket --jq '.[] | "\(.name)\t\(.bucket)"'
      CHECKS="$GH_OUT"
      case "$GH_STATUS" in
        0|8) ;;
        *)
          case "$GH_ERR" in
            *"no checks reported"*) CHECKS="" ;;
            *) gh_poll_fail "checks" ;;
          esac
          ;;
      esac
      while IFS= read -r NAME; do
        # Each run with this name counts. A failed or cancelled run fails
        # the check. ENVIRON, not -v: awk -v changes backslashes in a name.
        STATE="$(printf '%s\n' "$CHECKS" | N="$NAME" awk -F '\t' '
          $1 == ENVIRON["N"] {
            seen = 1
            if ($2 == "fail" || $2 == "cancel") { bad = $2 }
            else if ($2 != "pass" && $2 != "skipping") { wait = 1 }
          }
          END {
            if (bad != "") print bad
            else if (!seen || wait) print "pending"
            else print "pass"
          }')"
        case "$STATE" in
          pass) ;;
          fail|cancel)
            echo "Required check '${NAME}' is ${STATE} on PR #${PR_NUMBER}. Nothing merged. Fix the check, wait for it to pass, then run the script again." >&2
            exit 2
            ;;
          *) PENDING="${PENDING:+${PENDING}, }${NAME}" ;;
        esac
      done <<EOF
${REQUIRED_CHECKS}
EOF
    fi
    if [ -z "$PENDING" ]; then
      echo "Required checks pass."
      break
    fi
    if [ "$ELAPSED" -ge "$LIMIT" ]; then
      echo "Required checks not done after ${CHECKS_TIMEOUT_MIN} min: ${PENDING}. Nothing merged. Run the script again when the checks pass." >&2
      exit 2
    fi
    echo "Waiting for: ${PENDING}"
    sleep "$CHECK_INTERVAL"
    ELAPSED=$((ELAPSED + CHECK_INTERVAL))
  done
fi

# --- Step 8: merge the PR ---
step "Step 8: merge PR #${PR_NUMBER}"
if [ "$PR_STATE" = "MERGED" ]; then
  echo "PR #${PR_NUMBER} is already merged — skipping."
else
  run gh pr merge "$PR_NUMBER" "$MERGE_FLAG" --delete-branch --match-head-commit "$EXPECTED_HEAD"
fi

# --- Step 9: pull the merge commit ---
step "Step 9: pull merge commit"
run git pull --ff-only origin main

# --- Read the PR head after the merge ---
# Steps 10 and 13 need the final head. Before Step 6 pushed the notes
# removal, the head was a different commit.
if [ "$DRY_RUN" -eq 1 ]; then
  echo "[dry-run] gh pr view $PR_NUMBER --json headRefOid --jq .headRefOid  # PR_HEAD"
else
  PR_HEAD="$(gh pr view "$PR_NUMBER" --json headRefOid --jq '.headRefOid')"
  require_sha "$PR_HEAD" "head commit of PR #${PR_NUMBER}"
fi

# --- Step 10: delete local milestone branch, if present ---
# Step 8's gh pr merge --delete-branch normally deletes the local branch.
# This step deletes it on a rerun, for example after gh merged the PR but
# could not delete the local branch. Then gh may also keep the remote
# branch, and this step does not delete it. git branch -d refuses a
# squash-merged branch, because main does not contain its commits. The PR
# is merged at this point, so a local tip that is the PR head commit holds
# no unmerged work, and -D is safe.
step "Step 10: delete local milestone branch"
if [ "$DRY_RUN" -eq 1 ]; then
  echo "[dry-run] git branch -D $BRANCH  # only when its tip is PR_HEAD. Ignored if absent."
else
  LOCAL_TIP="$(git rev-parse -q --verify "refs/heads/${BRANCH}" || true)"
  if [ -z "$LOCAL_TIP" ]; then
    echo "No local ${BRANCH} — nothing to delete."
  elif [ "$LOCAL_TIP" = "$PR_HEAD" ]; then
    # A failed delete must not stop the release: each rerun would stop here
    # again, before the tag.
    git branch -D "$BRANCH" || echo "Could not delete local ${BRANCH}. Delete it by hand."
  else
    echo "Kept local ${BRANCH}: its tip ${LOCAL_TIP} is not the PR head ${PR_HEAD}. It may hold work that is not merged. Check it, then delete it by hand."
  fi
fi

# --- Step 11: tag the merge commit ---
# Tag the PR's merge commit by its SHA, not HEAD: a commit pushed to main
# after the merge would make HEAD the wrong commit.
step "Step 11: create annotated tag"
if [ "$DRY_RUN" -eq 1 ]; then
  echo "[dry-run] gh pr view $PR_NUMBER --json mergeCommit --jq .mergeCommit.oid  # MERGE_SHA"
  echo "[dry-run] git tag -a ${VERSION} <MERGE_SHA> -m \"Release ${VERSION}: <milestone title>\""
  echo "[dry-run] git rev-parse ${VERSION}^{commit}  # expect: <MERGE_SHA>"
else
  MERGE_SHA="$(gh pr view "$PR_NUMBER" --json mergeCommit --jq '.mergeCommit.oid')"
  require_sha "$MERGE_SHA" "merge commit of PR #${PR_NUMBER}"
  if git rev-parse -q --verify "refs/tags/${VERSION}" >/dev/null; then
    TAGGED_SHA="$(git rev-parse "${VERSION}^{commit}")"
    if [ "$TAGGED_SHA" != "$MERGE_SHA" ]; then
      echo "Tag ${VERSION} already exists on ${TAGGED_SHA}, not on the merge commit ${MERGE_SHA}. Stop and investigate." >&2
      exit 2
    fi
    echo "Tag ${VERSION} already exists on the merge commit — skipping."
  else
    MILESTONE_TITLE="$(gh api "repos/${REPO}/milestones/${MILESTONE_NUMBER}" --jq .title)"
    git tag -a "${VERSION}" "${MERGE_SHA}" -m "Release ${VERSION}: ${MILESTONE_TITLE}"
    TAGGED_SHA="$(git rev-parse "${VERSION}^{commit}")"
    if [ "$TAGGED_SHA" != "$MERGE_SHA" ]; then
      echo "Tag ${VERSION} points at ${TAGGED_SHA}, expected the merge commit ${MERGE_SHA}. Stop and investigate." >&2
      exit 2
    fi
  fi
fi

# --- Step 12: push the tag ---
step "Step 12: push tag to origin"
run git push origin "${VERSION}"

# --- Step 13: create the GitHub release ---
if [ "$RELEASE_FLAG" = "--draft" ]; then
  step "Step 13: create draft GitHub release"
else
  step "Step 13: create and publish GitHub release"
fi
if [ "$DRY_RUN" -eq 0 ] && gh release view "${VERSION}" --repo "$REPO" >/dev/null 2>&1; then
  echo "Release ${VERSION} already exists — skipping."
else
  if [ "$DRY_RUN" -eq 0 ] && [ ! -f "$KEEP_NOTES" ]; then
    # Search the PR head, not main: after a squash merge, main never had
    # the notes file. One path serves each merge method. A fresh clone or
    # a deleted branch can leave the head commit absent, so fetch it.
    if ! git cat-file -e "${PR_HEAD}^{commit}" 2>/dev/null; then
      if ! git fetch origin "refs/pull/${PR_NUMBER}/head" || ! git cat-file -e "${PR_HEAD}^{commit}" 2>/dev/null; then
        echo "No saved release notes at ${KEEP_NOTES}, and the PR head ${PR_HEAD} is not local. The fetch of refs/pull/${PR_NUMBER}/head did not get it. Restore ${KEEP_NOTES} by hand: take ${NOTES_FILE} from the parent of the notes removal commit on the PR. Then run the script again." >&2
        exit 2
      fi
    fi
    REMOVED_IN="$(notes_removal_commit "$PR_HEAD")"
    if [ -z "$REMOVED_IN" ]; then
      echo "No saved release notes at ${KEEP_NOTES}, and no commit in the history of the PR head ${PR_HEAD} removed ${NOTES_FILE}. Stop." >&2
      exit 2
    fi
    mkdir -p "$(dirname "$KEEP_NOTES")"
    # Write to a temp file first, so a failed git show leaves no empty copy
    # for the next run to publish.
    TMP_NOTES="${KEEP_NOTES}.tmp.$$"
    if ! git show "${REMOVED_IN}^:${NOTES_FILE}" > "$TMP_NOTES"; then
      rm -f "$TMP_NOTES"
      echo "Could not restore ${NOTES_FILE} from ${REMOVED_IN}^. Stop." >&2
      exit 2
    fi
    mv "$TMP_NOTES" "$KEEP_NOTES"
    echo "Restored release notes from ${REMOVED_IN}^ to ${KEEP_NOTES}."
  fi
  run gh release create "${VERSION}" \
    --repo "$REPO" \
    --title "${REPO#*/} ${VERSION}" \
    --notes-file "$KEEP_NOTES" \
    --verify-tag \
    "$RELEASE_FLAG"
fi
run rm -f "$KEEP_NOTES"

# --- Step 14: close the GitHub milestone ---
step "Step 14: close milestone #${MILESTONE_NUMBER}"
run gh api "repos/${REPO}/milestones/${MILESTONE_NUMBER}" -X PATCH -f state=closed
# The exit code proves only that the call returned. Read the state back, so a
# wrong milestone number or a missing permission cannot pass as "closed".
if [ "$DRY_RUN" -eq 0 ]; then
  MILESTONE_STATE="$(gh api "repos/${REPO}/milestones/${MILESTONE_NUMBER}" --jq .state)"
  if [ "$MILESTONE_STATE" != "closed" ]; then
    echo "Milestone #${MILESTONE_NUMBER} is '${MILESTONE_STATE}' after the close call, not 'closed'. Close it by hand, then check it." >&2
    exit 2
  fi
fi

echo "Done. Tag ${VERSION} pushed, PR #${PR_NUMBER} merged, milestone #${MILESTONE_NUMBER} closed."
if [ "$RELEASE_FLAG" = "--draft" ]; then
  echo "Release ${VERSION} is a DRAFT (${RELEASE_WHY}). Publish it when you deploy."
else
  echo "Release ${VERSION} is published and marked Latest (${RELEASE_WHY})."
fi
