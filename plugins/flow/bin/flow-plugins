#!/bin/bash
#
# Compares the plugins that this repo enables in .claude/settings.json with
# the plugins that Claude Code installed. Claude Code does not update a
# project-scope install, so an old install stays until a person updates it.
# This script finds that case and prints the fix command.
#
# The script only reads files. It reads the install records in
# ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/: installed_plugins.json,
# known_marketplaces.json, and the marketplace.json of each marketplace
# checkout. No Claude Code command prints this data in a stable form.
#
# Usage: flow-plugins --status [--running <plugin-root>]
#   --status   Print one line for each plugin with the value true in
#              enabledPlugins:
#                ok <plugin@mkt> <sha12>
#                missing <plugin@mkt>  fix: claude plugin install <plugin@mkt> --scope project
#                stale <plugin@mkt> <installed12> <expected12>  fix: claude plugin update <plugin@mkt> --scope <scope>
#                unknown <plugin@mkt>
#              An install counts when its scope is "project" or "local" and
#              its projectPath is this repo, or when its scope is "user".
#              <scope> is the scope of that install.
#              "unknown" has three causes:
#                - The marketplace gives no expected version.
#                - This repo pins a marketplace ref
#                  (extraKnownMarketplaces.<mkt>.source.ref) that is not
#                  the ref of the shared marketplace checkout. Then the
#                  checkout does not show the version that this repo
#                  expects.
#                - The marketplace.json of the marketplace does not list
#                  the plugin.
#              For the ref cause and the not-listed cause, stderr gives the
#              reason in one line.
#              A key that is not <name>@<name> (each name starts with a
#              letter or digit) is skipped. stderr names it, with other
#              characters changed to "?".
#   --running  Also compare the running plugin with the expected version.
#              <plugin-root> is CLAUDE_PLUGIN_ROOT. An installed plugin runs
#              from .../cache/<mkt>/<plugin>/<sha12>. If the expected
#              version is known and <sha12> is not the expected version,
#              print:
#                stale-running <plugin@mkt> <running12> <expected12>  fix: <fix>
#              <fix> is "restart the session" when the install is already
#              the expected version. Otherwise it is the update command for
#              the scope of the install, or the install command when there
#              is no install.
#              A root whose last name is not 12 hex characters (a
#              --plugin-dir session), or whose parent names have other
#              characters, is not compared.
#
# With no .claude/settings.json, or no enabled plugin in it, the script
# prints nothing. It does not run the --running check either.
#
# Exit codes:
#   0  No missing, stale, or stale-running line.
#   1  One or more missing, stale, or stale-running lines.
#   2  Usage error, not in a git repo, no jq, a JSON file that the script
#      cannot read or parse, or a marketplace checkout with a relative
#      plugin source and a .git where "git rev-parse HEAD" fails. A
#      checkout with no .git gives "unknown".

# The jq filters use jq variables such as $k, so single quotes are on purpose.
# shellcheck disable=SC2016
set -euo pipefail

prog="$(basename "$0")"

usage() {
    echo "Usage: ${prog} --status [--running <plugin-root>]" >&2
    exit 2
}

running=""
[ "${1:-}" = "--status" ] || usage
shift
if [ "$#" -gt 0 ]; then
    [ "$#" -eq 2 ] && [ "$1" = "--running" ] && [ -n "$2" ] || usage
    running="$2"
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "${prog}: jq is not installed." >&2
    exit 2
fi

if ! top="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    echo "${prog}: not in a git repository." >&2
    exit 2
fi
# Claude Code records projectPath as a physical path. On macOS, /tmp is a
# link to /private/tmp, so compare physical paths only.
top="$(cd -P "$top" && pwd -P)"

cfg="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}/plugins"
settings="${top}/.claude/settings.json"
installed="${cfg}/installed_plugins.json"
known="${cfg}/known_marketplaces.json"

# read_json <file> <jq-args...>: run jq on a file. A file that jq cannot
# read or parse is exit 2, because a guess here could hide a stale plugin.
read_json() {
    local file="$1" out
    shift
    if ! out="$(jq -r "$@" "$file" 2>/dev/null)"; then
        echo "${prog}: cannot read or parse ${file}." >&2
        exit 2
    fi
    printf '%s\n' "$out"
}

[ -f "$settings" ] || exit 0
# A key with a newline would split into two lines below, so jq changes the
# newline to "?". The name check then skips the key.
keys="$(read_json "$settings" '(.enabledPlugins // {}) | to_entries[] | select(.value == true) | .key | gsub("[\n\r]"; "?")')"
[ -n "$keys" ] || exit 0

tab="$(printf '\t')"
# jq joins install fields with the unit separator. A tab is IFS whitespace,
# so "read" joins two tabs into one and an empty field moves the fields
# after it. The unit separator is not IFS whitespace.
us="$(printf '\037')"

is_hex12() {
    [[ "$1" =~ ^[0-9a-f]{12}$ ]]
}

# Set globals. Do not print. A value that a function prints needs a command
# substitution, which hides the error exit of its caller.

# set_expected <plugin> <mkt>: set EXPECTED to the 12-character expected
# version, or to "" when the marketplace gives none. Set REF_DIFF to the
# repo ref when this repo pins a marketplace ref that is not the ref of the
# shared checkout, else to "". Set NOT_LISTED to 1 when the marketplace.json
# of the checkout does not list the plugin, else to "".
set_expected() {
    local plugin="$1" mkt="$2" loc mjson row kind value sha="" want_ref have_ref
    EXPECTED=""
    REF_DIFF=""
    NOT_LISTED=""
    [ -f "$known" ] || return 0
    loc="$(read_json "$known" --arg m "$mkt" '.[$m].installLocation // empty')"
    [ -n "$loc" ] || return 0
    # Claude Code keeps one checkout for each marketplace name. The last
    # project that opens sets its ref, so the checkout can be at another
    # ref than the one this repo pins.
    want_ref="$(read_json "$settings" --arg m "$mkt" '.extraKnownMarketplaces[$m].source.ref // empty | tostring')"
    if [ -n "$want_ref" ]; then
        have_ref="$(read_json "$known" --arg m "$mkt" '.[$m].source.ref // empty | tostring')"
        if [ "$want_ref" != "$have_ref" ]; then
            REF_DIFF="$(printf '%s' "$want_ref" | tr -c 'A-Za-z0-9._/-' '?' | cut -c1-40)"
            return 0
        fi
    fi
    mjson="${loc}/.claude-plugin/marketplace.json"
    [ -f "$mjson" ] || return 0
    # One jq call prints "<source type><TAB><value>". The value is the
    # string source, or the sha of an object source.
    row="$(read_json "$mjson" --arg p "$plugin" \
        'first(.plugins[]? | select(.name == $p) | .source
            | [type, (if type == "string" then . elif type == "object" then (.sha // "" | tostring) else "" end)]
            | @tsv) // empty')"
    if [ -z "$row" ]; then
        NOT_LISTED=1
        return 0
    fi
    kind="${row%%"${tab}"*}"
    value="${row#*"${tab}"}"
    case "$kind" in
        string)
            # A relative source is a folder in the marketplace checkout, so
            # the plugin version is the checkout commit. Some marketplaces
            # are a download with no .git, and give no commit ("unknown").
            # A .git that git cannot read (safe.directory, damage) is an
            # error: "unknown" would hide a stale plugin.
            case "$value" in
                ./*)
                    [ -e "${loc}/.git" ] || return 0
                    if ! sha="$(git -C "$loc" rev-parse HEAD 2>/dev/null)"; then
                        echo "${prog}: cannot read the git commit of the marketplace checkout ${loc}." >&2
                        exit 2
                    fi
                    ;;
            esac
            ;;
        object) sha="$value" ;;
    esac
    sha="$(printf '%s' "$sha" | cut -c1-12)"
    if is_hex12 "$sha"; then
        EXPECTED="$sha"
    fi
}

# set_install <key>: set INST_VERSION, INST_SHA, and INST_SCOPE for the
# install that applies to this repo, or set all to "" when there is none. A
# project or local install for this repo wins over a user install.
set_install() {
    local key="$1" rows scope path version gitsha phys
    INST_VERSION=""
    INST_SHA=""
    INST_SCOPE=""
    [ -f "$installed" ] || return 0
    rows="$(read_json "$installed" --arg k "$key" \
        '(.plugins[$k] // [])[] | [(.scope // ""), (.projectPath // ""), (.version // ""), (.gitCommitSha // "")]
            | map(tostring | gsub("[\u001f\n\r]"; "")) | join("\u001f")')"
    [ -n "$rows" ] || return 0
    while IFS="$us" read -r scope path version gitsha; do
        # Only text that is safe to print goes into the output.
        version="$(printf '%s' "$version" | tr -cd 'A-Za-z0-9.+-' | cut -c1-12)"
        gitsha="$(printf '%s' "$gitsha" | tr -cd '0-9a-f' | cut -c1-12)"
        [ -n "$version" ] || version="${gitsha:-none}"
        case "$scope" in
            project | local)
                phys="$(cd -P "$path" 2>/dev/null && pwd -P || printf '%s' "$path")"
                if [ "$phys" = "$top" ]; then
                    INST_VERSION="$version"
                    INST_SHA="$gitsha"
                    INST_SCOPE="$scope"
                    return 0
                fi
                ;;
            user)
                # Keep the first user install. A later project install for
                # this repo replaces it.
                if [ -z "$INST_VERSION" ]; then
                    INST_VERSION="$version"
                    INST_SHA="$gitsha"
                    INST_SCOPE="user"
                fi
                ;;
        esac
    done <<EOF
$rows
EOF
}

# install_is_expected: the install from set_install is the EXPECTED version.
install_is_expected() {
    [ -n "$INST_VERSION" ] && { [ "$INST_VERSION" = "$EXPECTED" ] || [ "$INST_SHA" = "$EXPECTED" ]; }
}

name_re='^[A-Za-z0-9][A-Za-z0-9._-]*$'
key_re='^[A-Za-z0-9][A-Za-z0-9._-]*@[A-Za-z0-9][A-Za-z0-9._-]*$'

found=0
while IFS= read -r key; do
    # The key goes into a command that a person runs and into session
    # context, so a key with other characters is not printed on stdout.
    if ! [[ "$key" =~ $key_re ]]; then
        echo "${prog}: skipped the enabledPlugins key $(printf '%s' "$key" | tr -c 'A-Za-z0-9._@-' '?' | cut -c1-80): not a <plugin>@<marketplace> name." >&2
        continue
    fi
    set_install "$key"
    if [ -z "$INST_VERSION" ]; then
        echo "missing ${key}  fix: claude plugin install ${key} --scope project"
        found=1
        continue
    fi
    set_expected "${key%@*}" "${key#*@}"
    if [ -n "$REF_DIFF" ]; then
        echo "${prog}: ${key}: this repo pins marketplace ref ${REF_DIFF}, but the shared checkout has another ref. The expected version is not known." >&2
        echo "unknown ${key}"
    elif [ -n "$NOT_LISTED" ]; then
        echo "${prog}: ${key}: the marketplace.json of ${key#*@} does not list ${key%@*}. The expected version is not known." >&2
        echo "unknown ${key}"
    elif [ -z "$EXPECTED" ]; then
        echo "unknown ${key}"
    elif install_is_expected; then
        echo "ok ${key} ${EXPECTED}"
    else
        echo "stale ${key} ${INST_VERSION} ${EXPECTED}  fix: claude plugin update ${key} --scope ${INST_SCOPE}"
        found=1
    fi
done <<EOF
$keys
EOF

if [ -n "$running" ]; then
    run12="$(basename "$running")"
    run_plugin="$(basename "$(dirname "$running")")"
    run_mkt="$(basename "$(dirname "$(dirname "$running")")")"
    if is_hex12 "$run12" \
        && [[ "$run_plugin" =~ $name_re ]] \
        && [[ "$run_mkt" =~ $name_re ]]; then
        set_expected "$run_plugin" "$run_mkt"
        if [ -n "$EXPECTED" ] && [ "$run12" != "$EXPECTED" ]; then
            run_key="${run_plugin}@${run_mkt}"
            set_install "$run_key"
            if install_is_expected; then
                # The install is current. Only the session loaded the old
                # copy, so an update changes nothing.
                run_fix="restart the session"
            elif [ -z "$INST_VERSION" ]; then
                run_fix="claude plugin install ${run_key} --scope project"
            else
                run_fix="claude plugin update ${run_key} --scope ${INST_SCOPE}"
            fi
            echo "stale-running ${run_key} ${run12} ${EXPECTED}  fix: ${run_fix}"
            found=1
        fi
    fi
fi

exit "$found"
