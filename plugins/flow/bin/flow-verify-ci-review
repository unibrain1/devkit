#!/usr/bin/env bash
# Verifies that a CI code review posted on a PR for its head commit, and
# recovers once if it did not. Then it checks the review for unresolved
# Blocking findings (and Important findings, with --include-important).
#
# WHY THIS SCRIPT EXISTS: a successful claude-code-review.yml run is not proof
# that a review posted. Three failure modes can each give a successful job with
# no review:
#   1. GitHub's abuse or rate throttle can drop the webhook event, so no run
#      starts (PR Registry #1718, Registry #1724).
#   2. The action skips a PR when a review workflow file at the PR head
#      differs from the copy on the default branch. These files are the
#      caller and each reusable workflow that the caller calls with
#      `uses: ./`. flow-review-workflow-files lists them. The PR itself, or
#      an earlier PR merged into its base branch, can change the file. This
#      is intended security behavior. It does not clear until the change
#      merges to main. When only main changed the file, the PR head has an
#      old copy. It clears when the PR branch gets the main copy.
#   3. The model can stop before it returns a review.
# The only proof is the review comment itself, never the job conclusion. This
# script is the single place that checks the comment and runs the one
# recovery. Callers must not copy this logic.
#
# A review counts only when it has a verdict for the head commit. The workflow
# step "Post review" posts the review as github-actions[bot]. The last line of
# that comment is a hidden verdict line:
#
#   <!-- claude-review-verdict sha=<head SHA> blocking=<n> important=<n> -->
#
# A verdict for an older SHA reviewed an earlier head. The script then waits,
# and recovers, as it does when no review exists. A human comment, a
# claude[bot] reply, and an old-format review (no verdict line) do not count.
# Only a workflow run that holds the GITHUB_TOKEN of this repo posts as
# github-actions[bot], and that needs write access to the repo. A fork PR
# gets a read-only token, so it cannot post.
#
# It wraps three scripts that other callers also use, and that have their own
# tests: flow-check-review-posted (count the verdicts for the head commit),
# flow-poll-review-posted (wait for one), and flow-check-blocking-findings
# (read the counts in the newest verdict).
#
# Usage:
#   flow-verify-ci-review <pr-number> <interval-s> <timeout-s> \
#       --trigger=<workflow|label|none> [--include-important] [--check-skip-tag]
#
#   --trigger=workflow   recovery re-runs the caller workflow (line 1 of
#                        flow-review-workflow-files): gh workflow run <caller>
#   --trigger=label      recovery re-applies the `deep-review` label (it
#                        removes the label first when the PR has it)
#   --trigger=none       no recovery trigger. A missing review after the poll
#                        window gives exit 4.
#   --include-important  after the review is confirmed, also fail (exit 2)
#                        when the verdict has important > 0
#   --check-skip-tag     before recovery, check the PR title for
#                        `[skip-review]`. milestone-review honors this tag and
#                        posts nothing on purpose. The script gives exit 3,
#                        not a failure.
#
# Exit codes:
#   0 = a verdict for the head commit exists, with blocking=0 (and
#       important=0 with --include-important)
#   1 = could not verify — a `gh` call failed (auth, network, rate limit),
#       the head commit could not be read, flow-repo could not resolve the
#       repo, flow-review-workflow-files or a blob or merge base lookup of
#       the guard failed, or the arguments are not valid.
#       This is NOT the same as "no review posted".
#   2 = a verdict for the head commit exists, but blocking > 0 (or, with
#       --include-important, important > 0). See stdout for the counts.
#   3 = no review, but the PR title has `[skip-review]` — the correct outcome
#       by design (--check-skip-tag only)
#   4 = no verdict for the head commit after the poll and one recovery
#       attempt (or after the poll alone, with --trigger=none). With
#       --trigger=workflow, also no verdict after the poll alone when a
#       review workflow file at the PR head differs from main. stderr then
#       holds "requires a merge to main first" (this branch or its base
#       branch changed the file) or "is an old copy" (only main changed it)
#   5 = reserved (not used. --include-important failures use exit 2, so
#       every unresolved finding gives the same code)
#
# Recovery runs at most once. Sometimes recovery cannot help. For example,
# with --trigger=workflow, a PR whose head has a review workflow file that
# differs from main cannot get a review before the merge, or before the PR
# branch gets the main copy. The script then prints why and exits 4. It
# does not loop.
#
# History: Registry #1724 (a throttle dropped the review event of PR Registry #1718), Registry #2314
# (a review for an older head counted), Registry #2506 (the old heading test missed a
# review that had no anchor heading).

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

PR_NUM=""
INTERVAL=""
TIMEOUT=""
TRIGGER=""
INCLUDE_IMPORTANT=0
CHECK_SKIP_TAG=0

for arg in "$@"; do
  case "$arg" in
    --trigger=*) TRIGGER="${arg#--trigger=}" ;;
    --include-important) INCLUDE_IMPORTANT=1 ;;
    --check-skip-tag) CHECK_SKIP_TAG=1 ;;
    ''|*[!0-9]*)
      echo "Unrecognized argument '$arg'." >&2
      exit 1
      ;;
    *)
      if [ -z "$PR_NUM" ]; then PR_NUM="$arg"
      elif [ -z "$INTERVAL" ]; then INTERVAL="$arg"
      elif [ -z "$TIMEOUT" ]; then TIMEOUT="$arg"
      else
        echo "Too many positional arguments." >&2
        exit 1
      fi
      ;;
  esac
done

if [ -z "$PR_NUM" ] || [ -z "$INTERVAL" ] || [ -z "$TIMEOUT" ]; then
  echo "Usage: flow-verify-ci-review <pr-number> <interval-s> <timeout-s> --trigger=<workflow|label|none> [--include-important] [--check-skip-tag]" >&2
  exit 1
fi

case "$TRIGGER" in
  workflow|label|none) ;;
  *)
    echo "Missing or invalid --trigger=<workflow|label|none>." >&2
    exit 1
    ;;
esac

# The repo is read one time. flow-repo prints its own error.
if ! REPO="$("${SCRIPT_DIR}/flow-repo")"; then
  exit 1
fi

# --- Verdict rule -----------------------------------------------------------
# The same rule is in flow-check-review-posted, flow-check-blocking-findings,
# flow-verify-ci-review, and the jq filter TRUSTED_COMMENTS_JQ in
# .github/workflows/claude-review.yml. The "Post review" step of the review
# workflow writes the verdict line. When one copy changes, change all of them.
#
# Explicit characters, not ranges: a range such as a-f can follow the locale.
VERDICT_RE='^<!-- claude-review-verdict sha=([0123456789abcdef]{40}) blocking=([0123456789]+) important=([0123456789]+) -->$'

# Prints one line per verdict for the PR head commit, oldest first:
# created_at, comment ID, blocking count, important count (tab-separated).
# Returns 1 when a gh call fails or the head SHA is not valid.
head_verdicts() {
  local pr="$1" head_sha records created id last_line found=""
  if ! head_sha=$(gh pr view "$pr" --repo "$REPO" --json headRefOid -q .headRefOid); then
    echo "Could not read the head commit of PR #${pr}." >&2
    return 1
  fi
  if ! [[ $head_sha =~ ^[0123456789abcdef]{40}$ ]]; then
    echo "The head commit of PR #${pr} is not a 40-character lowercase SHA (got '${head_sha}')." >&2
    return 1
  fi
  # gh runs the --jq filter on each page separately (--paginate). So the
  # filter prints one record per comment, and never a total. The record holds
  # the last line of the body, after the filter removes each CR and one
  # trailing newline. The filter is one line, so a log of the call is one line.
  local filter='.[] | select(.user.login == "github-actions[bot]")'
  filter+=' | [(.created_at // ""), (.id | tostring), ((.body // "") | gsub("\r"; "")'
  filter+=' | (if endswith("\n") then .[:-1] else . end) | split("\n") | (last // ""))] | @tsv'
  if ! records=$(gh api "repos/${REPO}/issues/${pr}/comments" --paginate \
      --jq "$filter"); then
    echo "Could not read the comments of PR #${pr}." >&2
    return 1
  fi
  while IFS=$'\t' read -r created id last_line; do
    [[ $last_line =~ $VERDICT_RE ]] || continue
    [ "${BASH_REMATCH[1]}" = "$head_sha" ] || continue
    found+="${created}"$'\t'"${id}"$'\t'"${BASH_REMATCH[2]}"$'\t'"${BASH_REMATCH[3]}"$'\n'
  done <<< "$records"
  if [ -n "$found" ]; then
    printf '%s' "$found" | LC_ALL=C sort -t $'\t' -k1,1 -k2,2n
  fi
  return 0
}
# --- End of verdict rule ----------------------------------------------------

# Does a verdict for the PR head commit exist? A verdict for an older SHA
# reviewed an earlier head, so a later run must not accept it (Registry #2314).
# Returns 0 = fresh, 1 = no verdict for the head, 2 = could not verify.
review_is_fresh() {
  local verdicts
  if ! verdicts=$(head_verdicts "$PR_NUM"); then
    return 2
  fi
  if [ -z "$verdicts" ]; then
    echo "PR #${PR_NUM} has no review verdict for its head commit." >&2
    return 1
  fi
  return 0
}

# Waits for a review comment for the PR's head commit.
# Returns 0 = found, 1 = none after the timeout, 2 = could not verify.
poll() {
  local poll_status=0 fresh_status elapsed=0
  "$SCRIPT_DIR/flow-poll-review-posted" "$PR_NUM" "$INTERVAL" "$TIMEOUT" || poll_status=$?
  if [ "$poll_status" -ne 0 ]; then
    return "$poll_status"
  fi
  while :; do
    fresh_status=0
    review_is_fresh || fresh_status=$?
    if [ "$fresh_status" -ne 1 ]; then
      return "$fresh_status"
    fi
    if [ "$elapsed" -ge "$TIMEOUT" ]; then
      echo "No review comment for the head commit after ${TIMEOUT}s." >&2
      return 1
    fi
    sleep "$INTERVAL"
    elapsed=$((elapsed + INTERVAL))
  done
}

# gh_capture <gh args...>
# Runs gh and sets GH_STATUS, GH_OUT (stdout) and GH_ERR (stderr). A notice
# that gh prints on stderr then cannot change the value that the caller
# matches. Returns 1 when it cannot make the temp file for stderr.
gh_capture() {
  local err
  err="$(mktemp)" || return 1
  GH_STATUS=0
  GH_OUT="$(gh "$@" 2>"$err")" || GH_STATUS=$?
  GH_ERR="$(cat "$err")"
  rm -f "$err"
  return 0
}

# Prints the blob SHA of <path> at <ref>. The "Check workflow match" step of
# claude-review.yml does the same lookup. Prints nothing when the file is
# absent at <ref> (HTTP 404): that step reads an absent file as no mismatch.
# Returns 1 on any other failure, so the guard fails closed. The SHA test
# reads stdout only. The 404 test reads stderr only, because gh prints the
# HTTP status there.
blob_sha() {
  local path="$1" ref="$2"
  if ! gh_capture api "repos/${REPO}/contents/${path}?ref=${ref}" --jq .sha; then
    echo "flow-verify-ci-review: could not verify: could not make a temp file for the blob lookup of ${path} at ${ref}, so the workflow-file guard cannot be checked." >&2
    return 1
  fi
  if [ "$GH_STATUS" -eq 0 ]; then
    if [[ $GH_OUT =~ ^[0123456789abcdef]{40}([0123456789abcdef]{24})?$ ]]; then
      printf '%s' "$GH_OUT"
      return 0
    fi
    echo "flow-verify-ci-review: could not verify: the blob of ${path} at ${ref} is not a SHA (got '${GH_OUT}'), so the workflow-file guard cannot be checked." >&2
    return 1
  fi
  case "$GH_ERR" in
    *"(HTTP 404)"*) return 0 ;;
  esac
  echo "flow-verify-ci-review: could not verify: the blob of ${path} at ${ref} could not be read, so the workflow-file guard cannot be checked: ${GH_ERR}" >&2
  return 1
}

# Prints the merge base of main and <head SHA>. The "Check workflow match"
# step gets it from the same compare call, with the default branch in place
# of main. Returns 1 on any failure, so the guard fails closed.
merge_base_sha() {
  local head="$1"
  if ! gh_capture api "repos/${REPO}/compare/main...${head}" --jq .merge_base_commit.sha; then
    echo "flow-verify-ci-review: could not verify: could not make a temp file for the merge base lookup, so the workflow-file guard cannot be checked." >&2
    return 1
  fi
  if [ "$GH_STATUS" -ne 0 ]; then
    echo "flow-verify-ci-review: could not verify: the merge base of main and ${head} could not be read, so the workflow-file guard cannot be checked: ${GH_ERR}" >&2
    return 1
  fi
  if ! [[ $GH_OUT =~ ^[0123456789abcdef]{40}$ ]]; then
    echo "flow-verify-ci-review: could not verify: the merge base of main and ${head} is not a SHA (got '${GH_OUT}'), so the workflow-file guard cannot be checked." >&2
    return 1
  fi
  printf '%s' "$GH_OUT"
}

# Initial poll.
if poll; then
  : # comment found
else
  poll_status=$?
  if [ "$poll_status" -eq 2 ]; then
    echo "flow-verify-ci-review: could not verify (see the output above)." >&2
    exit 1
  fi

  # poll_status == 1: genuinely no comment yet.
  if [ "$CHECK_SKIP_TAG" -eq 1 ]; then
    TITLE=""
    if ! TITLE=$(gh pr view "$PR_NUM" --repo "$REPO" --json title -q .title 2>&1); then
      echo "flow-verify-ci-review: warning: could not read the PR title ('$TITLE'); skipping the [skip-review] check." >&2
      TITLE=""
    fi
    case "$TITLE" in
      *"[skip-review]"*)
        echo "PR title carries [skip-review] — no comment is the correct, by-design outcome."
        exit 3
        ;;
    esac
  fi

  if [ "$TRIGGER" = "none" ]; then
    echo "No review comment found after ${TIMEOUT}s; --trigger=none, no recovery attempted." >&2
    exit 4
  fi

  # Self-referential-workflow-file check applies only to the workflow trigger:
  # re-running the workflow cannot clear a skip caused by the workflow file
  # itself not yet being the one merged to main.
  if [ "$TRIGGER" = "workflow" ]; then
    # The caller and each local reusable workflow it calls (#76). Fail
    # closed: with no list, the guard cannot be checked.
    if ! REVIEW_FILES=$("$SCRIPT_DIR/flow-review-workflow-files"); then
      echo "flow-verify-ci-review: could not verify: flow-review-workflow-files failed, so the workflow-file guard cannot be checked." >&2
      exit 1
    fi
    # Compare the blob at the PR head with the blob on main. The CI step
    # "Check workflow match" compares with the default branch. The PR file
    # list is not enough: after a change to the file merges into a
    # milestone branch, a later PR on that branch does not change the file,
    # but its head copy still differs from main, so the action skips it.
    if ! GUARD_HEAD_SHA=$(gh pr view "$PR_NUM" --repo "$REPO" --json headRefOid -q .headRefOid) \
        || ! [[ $GUARD_HEAD_SHA =~ ^[0123456789abcdef]{40}$ ]]; then
      echo "flow-verify-ci-review: could not verify: the head commit of PR #${PR_NUM} could not be read, so the workflow-file guard cannot be checked." >&2
      exit 1
    fi
    # A mismatch is edited or stale, with the rule of the CI step. The blob
    # at the merge base of main and the head tells them apart:
    #   stale  - the head blob is the merge-base blob, so only main changed
    #            the file. stale wins over edited, as in the CI step.
    #   edited - this branch or its base branch changed the file. A file
    #            that is absent at the merge base is also edited here. The
    #            CI step reads it as no result, and the Gate fails.
    # The merge base is read only at the first mismatch.
    STALE_PATH=""
    EDITED_PATH=""
    MERGE_BASE=""
    while IFS= read -r WF_PATH; do
      [ -n "$WF_PATH" ] || continue
      MAIN_BLOB=$(blob_sha "$WF_PATH" main) || exit 1
      HEAD_BLOB=$(blob_sha "$WF_PATH" "$GUARD_HEAD_SHA") || exit 1
      # A file that is absent on one side is not a mismatch, as in the CI
      # step.
      if [ -z "$MAIN_BLOB" ] || [ -z "$HEAD_BLOB" ] || [ "$MAIN_BLOB" = "$HEAD_BLOB" ]; then
        continue
      fi
      if [ -z "$MERGE_BASE" ]; then
        MERGE_BASE=$(merge_base_sha "$GUARD_HEAD_SHA") || exit 1
      fi
      BASE_BLOB=$(blob_sha "$WF_PATH" "$MERGE_BASE") || exit 1
      if [ "$HEAD_BLOB" = "$BASE_BLOB" ]; then
        STALE_PATH="$WF_PATH"
        break
      fi
      [ -n "$EDITED_PATH" ] || EDITED_PATH="$WF_PATH"
    done <<< "$REVIEW_FILES"
    if [ -n "$STALE_PATH" ]; then
      echo "Review workflow file ${STALE_PATH} at the PR head is an old copy. Only main changed it. Update the PR branch from its base branch, after the base branch has the main copy. Recovery skipped." >&2
      exit 4
    fi
    if [ -n "$EDITED_PATH" ]; then
      echo "The review workflow itself (${EDITED_PATH}) at the PR head differs from main — the action's own workflow-file-must-match-main guard blocks a pre-merge re-run from clearing this. Recovery skipped; this requires a merge to main first." >&2
      exit 4
    fi
    # Line 1 is the caller, the workflow that a recovery run starts.
    CALLER_WF=${REVIEW_FILES%%$'\n'*}
    CALLER_WF=${CALLER_WF##*/}
    if ! RECOVERY_ERR=$(gh workflow run "$CALLER_WF" --ref main --field "pr_number=${PR_NUM}" --repo "$REPO" 2>&1); then
      echo "flow-verify-ci-review: could not verify: recovery trigger failed:" >&2
      echo "  gh workflow run ${CALLER_WF} --ref main --field pr_number=${PR_NUM} --repo ${REPO}" >&2
      echo "  $RECOVERY_ERR" >&2
      exit 1
    fi
  else
    # Adding a label that the PR already has sends no `labeled` event, so
    # remove it first.
    if ! LABELS=$(gh pr view "$PR_NUM" --repo "$REPO" --json labels --jq '.labels[].name' 2>&1); then
      echo "flow-verify-ci-review: could not verify: could not read the PR labels: $LABELS" >&2
      exit 1
    fi
    if grep -Fxq 'deep-review' <<< "$LABELS"; then
      if ! RECOVERY_ERR=$(gh pr edit "$PR_NUM" --remove-label "deep-review" --repo "$REPO" 2>&1); then
        echo "flow-verify-ci-review: could not verify: recovery trigger failed:" >&2
        echo "  gh pr edit ${PR_NUM} --remove-label deep-review --repo ${REPO}" >&2
        echo "  $RECOVERY_ERR" >&2
        exit 1
      fi
    fi
    if ! RECOVERY_ERR=$(gh pr edit "$PR_NUM" --add-label "deep-review" --repo "$REPO" 2>&1); then
      echo "flow-verify-ci-review: could not verify: recovery trigger failed:" >&2
      echo "  gh pr edit ${PR_NUM} --add-label deep-review --repo ${REPO}" >&2
      echo "  $RECOVERY_ERR" >&2
      exit 1
    fi
  fi

  echo "Recovery trigger sent (--trigger=${TRIGGER}); re-polling once."
  # Capture the status before testing it: `if ! poll; then s=$?` stores the
  # negated result, which is always 0 (Registry #2222).
  poll_status=0
  poll || poll_status=$?
  if [ "$poll_status" -ne 0 ]; then
    if [ "$poll_status" -eq 2 ]; then
      echo "flow-verify-ci-review: could not verify after recovery (see output above)." >&2
      exit 1
    fi
    echo "No review comment found after recovery + a second ${TIMEOUT}s poll." >&2
    exit 4
  fi
fi

echo "Review comment confirmed on PR #${PR_NUM}."

if [ "$INCLUDE_IMPORTANT" -eq 1 ]; then
  FLAG="--include-important"
else
  FLAG=""
fi

check_status=0
"$SCRIPT_DIR/flow-check-blocking-findings" "$PR_NUM" $FLAG || check_status=$?
if [ "$check_status" -ne 0 ]; then
  if [ "$check_status" -eq 2 ]; then
    echo "flow-verify-ci-review: flow-check-blocking-findings could not verify findings." >&2
    exit 1
  fi
  exit 2
fi

exit 0
